    <!--
      The Telegram bot token is not stored here. To run the notification test
      against the real Telegram API, pass the values through the environment:
        TEST_NOTIFICATION=true GEMBOOT_TELEGRAM_BOT_TOKEN=... GEMBOOT_TELEGRAM_CHAT_ID=... vendor/bin/phpunit
      PHPUnit does not overwrite environment variables that are already set.
    -->

    <env name="TEST_AUTH" value="false"/>
    <env name="TEST_FILE_HANDLER" value="false"/>
    <env name="TEST_NOTIFICATION" value="false"/>
